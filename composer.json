{
  "name": "aanggakrishna/laravel-browser-cache-manager",
  "description": "Safe, opt-in browser cache version management for Laravel applications.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.1",
    "illuminate/console": "^10.0 || ^11.0 || ^12.0",
    "illuminate/database": "^10.0 || ^11.0 || ^12.0",
    "illuminate/http": "^10.0 || ^11.0 || ^12.0",
    "illuminate/routing": "^10.0 || ^11.0 || ^12.0",
    "illuminate/support": "^10.0 || ^11.0 || ^12.0",
    "illuminate/view": "^10.0 || ^11.0 || ^12.0"
  },
  "require-dev": {
    "orchestra/testbench": "^8.0 || ^9.0 || ^10.0",
    "phpunit/phpunit": "^10.0 || ^11.0"
  },
  "autoload": {"psr-4": {"Aanggakrishna\\BrowserCacheManager\\": "src/"}},
  "autoload-dev": {"psr-4": {"Aanggakrishna\\BrowserCacheManager\\Tests\\": "tests/"}},
  "extra": {"laravel": {"providers": ["Aanggakrishna\\BrowserCacheManager\\BrowserCacheManagerServiceProvider"]}},
  "scripts": {"test": "phpunit", "analyse": "php -l src/BrowserCacheManagerServiceProvider.php"},
  "minimum-stability": "stable",
  "prefer-stable": true
}
